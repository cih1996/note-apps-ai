# 向量知识库配置文件示例
# 复制此文件为 .env 并修改配置

# ============================================
# 数据存储路径
# ============================================
KNOWLEDGE_DB_PATH=./knowledge_db
BACKUP_DB_PATH=./backup.db

# ============================================
# 向量模型配置
# ============================================
# 向量模型名称
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 向量模型本地路径（如果已下载，设置此路径避免联网）
# EMBEDDING_MODEL_PATH=D:/models/bge-small-zh-v1.5

# ============================================
# AI 描述生成模型配置
# ============================================
# AI 模型名称
AI_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# AI 模型本地路径（如果已下载，设置此路径避免联网）
# AI_MODEL_PATH=D:/models/Qwen2.5-1.5B-Instruct

# 是否禁用 AI 模型
DISABLE_AI_MODEL=false

# ============================================
# HuggingFace 配置（解决联网问题）
# ============================================
# 【推荐配置】本地文件优先模式
# true = 优先使用本地缓存，必要时可访问元数据（推荐）
# false = 允许下载模型（首次使用时需要）
# 
# 使用建议：
# 1. 首次使用：设为 false，让系统自动下载模型
# 2. 模型下载后：设为 true，优先使用缓存
LOCAL_FILES_ONLY=true

# 【请勿修改】完全离线模式（会导致加载失败）
# 注意：即使模型已完整缓存，HF_HUB_OFFLINE=true 也会导致 transformers 无法加载
# 原因：transformers 需要访问一些元数据，完全离线会阻止这些操作
# 
# 不用担心隐私/安全：
# - LOCAL_FILES_ONLY=true 已经确保优先使用本地缓存
# - transformers 只是读取一些配置元数据，不会上传任何数据
# - 如果模型已缓存，实际上不会下载任何文件
# 
# 建议：保持为 false（或者直接删除这一行）
# HF_HUB_OFFLINE=false

# HuggingFace 缓存目录
# Windows 默认: C:\Users\你的用户名\.cache\huggingface
# HF_HOME=D:/huggingface_cache

# 使用国内镜像（如果需要下载）
# HF_ENDPOINT=https://hf-mirror.com

# ============================================
# Web 服务配置
# ============================================
WEB_HOST=0.0.0.0
WEB_PORT=8000

